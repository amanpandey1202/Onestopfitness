# ONE STOP FITNESS — environment configuration template
# Copy to .env and fill in real production values.

# SQLite for local dev. For production use Postgres (e.g. Supabase, Neon, Railway):
# DATABASE_URL="postgresql://user:password@host/db?sslmode=require"
# In production, route app traffic through the Supabase pooler (port 6543):
#   DATABASE_URL="postgresql://user:password@aws-0-XX.pooler.supabase.com:6543/db?pgbouncer=true&sslmode=require"
#   DIRECT_URL="postgresql://user:password@aws-0-XX.pooler.supabase.com:5432/db?sslmode=require"
DATABASE_URL="file:./dev.db"

NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Seed credentials (first admin + demo accounts)
SEED_ADMIN_NAME=""
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD="CHANGE_ME_set_a_strong_unique_admin_password"

# Storage provider: "local" (files on disk) | "supabase" (durable cloud storage)
STORAGE_PROVIDER="local"

# Supabase Storage — required when STORAGE_PROVIDER="supabase".
# SUPABASE_URL is auto-derived from a supabase.co DATABASE_URL if not set.
# SUPABASE_SERVICE_ROLE_KEY: Supabase Dashboard → Project Settings → API → service_role (secret).
# Supabase Storage free tier is 1GB.
SUPABASE_URL="https://PROJECT_REF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="uploads"

# Security & Webhook Secrets
# Aadhaar (and other PII) is encrypted at rest with AES-256-GCM using this key.
# Generate a strong 32+ char secret and keep it safe. Required in production.
AADHAAR_ENCRYPTION_KEY="CHANGE_ME_generate_a_strong_encryption_key_for_pii"

# N8N webhook authentication token — sent in x-webhook-secret header
N8N_WEBHOOK_SECRET="CHANGE_ME_generate_a_random_n8n_webhook_secret"

# Cron job authorization secret for /api/cron
CRON_SECRET="CHANGE_ME_generate_a_random_cron_secret"

# Razorpay Payments (dashboard.razorpay.com)
RAZORPAY_KEY_ID="rzp_test_xxxxxx"
RAZORPAY_KEY_SECRET="xxxxxx"
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_xxxxxx"

# Email Integration (provider-agnostic)
# Powers welcome, expiry, password-reset and email-verification messages.
# Without a key, emails are printed to the server console instead of delivered.
#
# EMAIL_PROVIDER:
#   "brevo"  → Brevo transactional API. NO domain/DNS needed — verify your sender
#              email by clicking the confirmation link Brevo emails to it.
#              Needs BREVO_API_KEY (Brevo → SMTP & API → API Keys).
#   "resend" → Resend API. REQUIRES a verified domain (Resend → Domains).
#              Needs RESEND_API_KEY.
#
# EMAIL_FROM must be a sender verified in the chosen provider.
EMAIL_PROVIDER="resend"
RESEND_API_KEY=""
BREVO_API_KEY=""
EMAIL_FROM="GYM BRAND <noreply@onestopfit.in>"

# Gemini AI Key (optional for engagement AI analysis)
GEMINI_API_KEY=""
