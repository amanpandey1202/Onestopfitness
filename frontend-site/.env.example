# ONE STOP FITNESS — environment configuration template
# Copy to .env and fill in real production values.

# SQLite for local dev. For production use Postgres (e.g. Supabase, Neon, Railway):
# DATABASE_URL="postgresql://user:password@host/db?sslmode=require"
DATABASE_URL="file:./dev.db"

NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Seed credentials (first admin + demo accounts)
SEED_ADMIN_NAME="Deepak"
SEED_ADMIN_EMAIL="admin@onestopfit.in"
SEED_ADMIN_PASSWORD="CHANGE_ME_set_a_strong_unique_admin_password"

# Storage provider: "local" | "cloudinary"
STORAGE_PROVIDER="local"

# Security & Webhook Secrets
# Aadhaar (and other PII) is encrypted at rest with AES-256-GCM using this key.
# Generate a strong 32+ char secret and keep it safe. Required in production.
AADHAAR_ENCRYPTION_KEY="CHANGE_ME_generate_a_strong_encryption_key_for_pii"

# N8N webhook authentication token — sent in x-webhook-secret header
N8N_WEBHOOK_SECRET="CHANGE_ME_generate_a_random_n8n_webhook_secret"

# Cron job authorization secret for /api/cron
CRON_SECRET="CHANGE_ME_generate_a_random_cron_secret"

# Razorpay Payments (dashboard.razorpay.com)
RAZORPAY_KEY_ID="rzp_test_xxxxxx"
RAZORPAY_KEY_SECRET="xxxxxx"
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_xxxxxx"

# Resend Email Integration (resend.com)
RESEND_API_KEY=""
EMAIL_FROM="ONE STOP FITNESS <noreply@onestopfit.in>"

# Gemini AI Key (optional for engagement AI analysis)
GEMINI_API_KEY=""
